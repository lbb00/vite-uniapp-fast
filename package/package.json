{
  "name": "vite-uniapp-fast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pkgroll --clean-dist",
    "build:check": "pkgroll --clean-dist && node scripts/smoke-dual.mjs"
  },
  "dependencies": {
    "rollup": "^4.64.6"
  },
  "description": "True Opt C Vite plugin for classic uni-app mp-weixin (surgical / midpath / closure)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./optc-ext": {
      "import": {
        "types": "./dist/optc-ext.d.mts",
        "default": "./dist/optc-ext.mjs"
      },
      "require": {
        "types": "./dist/optc-ext.d.cts",
        "default": "./dist/optc-ext.cjs"
      }
    },
    "./optc-ext-vite": {
      "import": {
        "types": "./dist/optc-ext-vite.d.mts",
        "default": "./dist/optc-ext-vite.mjs"
      },
      "require": {
        "types": "./dist/optc-ext-vite.d.cts",
        "default": "./dist/optc-ext-vite.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "PACKAGING.md",
    "OPTIMIZATIONS.md"
  ],
  "peerDependencies": {
    "vite": ">=4.0.0",
    "@vue/compiler-sfc": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vue/compiler-sfc": "^3.5.44",
    "pkgroll": "^2.28.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
